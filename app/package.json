{
  "name": "video-automation-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-local Tutor-T video playback and lesson navigation",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:skill": "node scripts/install-skill.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "check": "node scripts/check.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test": "playwright test --config config/playwright.config.js",
    "test:chromium": "playwright test --config config/playwright.config.js --project=chromium",
    "test:firefox": "playwright test --config config/playwright.config.js --project=firefox",
    "test:webkit": "playwright test --config config/playwright.config.js --project=webkit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
